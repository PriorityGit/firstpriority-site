        .cta-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent), var(--accent3), transparent);
        }

        /* Footer */
        footer {
            border-top: 1px solid var(--border);

        }

        /* Grid */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.25rem;
        }

        @media (min-width: 768px) {
            .grid-2 { grid-template-columns: repeat(2, 1fr); }
        }

        /* Divider */
        .section-divider {

  const closeBtn = document.getElementById('fp-chat-close');
  const messages = document.getElementById('fp-chat-messages');
  const input = document.getElementById('fp-chat-input');
  const send = document.getElementById('fp-chat-send');

  btn.addEventListener('click', () => { win.classList.toggle('open'); if(win.classList.contains('open')) input.focus(); });
  closeBtn.addEventListener('click', () => win.classList.remove('open'));

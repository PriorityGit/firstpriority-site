    const div = document.createElement('div');
    div.className = 'fp-msg ' + (role==='user'?'user':'sarah');
    if(role==='sarah') {
      // Convert markdown links to HTML and plain URLs to clickable links
      let html = text
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" style="color:#00d4ff;text-decoration:underline;">$1</a>')
        .replace(/(?<!href=["'])(https?:\/\/[^\s<>"]+)/g, '<a href="$1" target="_blank" style="color:#00d4ff;text-decoration:underline;">$1</a>');
      div.innerHTML = html;
    } else { div.textContent = text; }
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function showTyping() {
    const div = document.createElement('div');
    div.className = 'fp-msg sarah fp-typing';
    div.id = 'fp-typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function hideTyping() { const t=document.getElementById('fp-typing'); if(t) t.remove(); }

  async function sendMessage() {
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    send.disabled = true;
    addMsg(text, 'user');
    history.push({ role: 'user', content: text });
    showTyping();
    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'ngrok-skip-browser-warning': 'true' },
        body: JSON.stringify({ messages: history })
      });
      const data = await res.json();
      const reply = data.reply || "Sorry, try calling us at +1-831-661-9911.";
      hideTyping();
      addMsg(reply, 'sarah');
      history.push({ role: 'assistant', content: reply });
    } catch(err) {
      hideTyping();
      addMsg("Something went wrong. Give us a call at +1-831-661-9911.", 'sarah');
    }
    send.disabled = false;
    input.focus();
  }
})();
</script>


<script>
/* ===== Pixel field background ===== */
(function(){
  const canvas = document.getElementById('fp-particles');
  if(!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, pixels = [];
  const PALETTE = ['0,212,255','0,255,157','167,139,250'];
  const mobile = window.innerWidth < 600;

  function resize(){
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
    init();
  }
  function spawn(){
    const sz = Math.random() < 0.15 ? 3 : (Math.random() < 0.5 ? 2 : 1);
    return {
      x: Math.random()*W, y: Math.random()*H,
      vx: (Math.random()-0.5)*0.22, vy: (Math.random()-0.5)*0.22,
      s: sz, base: Math.random()*0.32 + 0.12,
      tw: Math.random()*Math.PI*2, tws: Math.random()*0.02 + 0.004,
      col: PALETTE[Math.random() < 0.78 ? 0 : (Math.random() < 0.5 ? 1 : 2)]
    };
  }
  function init(){
    pixels = [];
    const density = mobile ? 13000 : 6500;
    const count = Math.min(mobile ? 95 : 280, Math.floor((W*H)/density));
    for(let i=0;i<count;i++) pixels.push(spawn());
  }
  function draw(){
    ctx.clearRect(0,0,W,H);
    for(const p of pixels){
      p.x += p.vx; p.y += p.vy; p.tw += p.tws;
      if(p.x < -4) p.x = W+4; if(p.x > W+4) p.x = -4;
      if(p.y < -4) p.y = H+4; if(p.y > H+4) p.y = -4;
      const a = p.base * (0.55 + 0.45*Math.sin(p.tw));
      ctx.fillStyle = 'rgba(' + p.col + ',' + a + ')';
      ctx.fillRect(p.x, p.y, p.s, p.s);
    }
    if(!mobile){
      for(let i=0;i<pixels.length;i++){
        for(let j=i+1;j<pixels.length;j++){
          const dx = pixels[i].x - pixels[j].x, dy = pixels[i].y - pixels[j].y;
          const d2 = dx*dx + dy*dy;
          if(d2 < 8100){
            const o = 0.06 * (1 - Math.sqrt(d2)/90);
            ctx.strokeStyle = 'rgba(0,212,255,' + o + ')';
            ctx.lineWidth = 0.5;
            ctx.beginPath();
            ctx.moveTo(pixels[i].x, pixels[i].y);
            ctx.lineTo(pixels[j].x, pixels[j].y);
            ctx.stroke();
          }
        }
      }
    }
    requestAnimationFrame(draw);
  }
  window.addEventListener('resize', resize);
  resize();
  draw();
})();

/* ===== Pixel intro: grid pops up, then pixels burst out and reveal the site ===== */
(function(){
  const intro = document.getElementById('pixel-intro');
  if(!intro) return;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce){ intro.remove(); return; }
  const mobile = window.innerWidth < 600;
  const W = window.innerWidth, H = window.innerHeight;
  const cx = W/2, cy = H/2;
  document.body.classList.add('intro-active');

  // Phase 1 — the grid pops up
  const grid = document.createElement('div');
  grid.className = 'intro-grid';
  intro.appendChild(grid);
  requestAnimationFrame(function(){ grid.classList.add('on'); });

  // Phase 2 — scattered pixels fly in and assemble onto the real content, tinted to match it, then dissolve to reveal it
  function assemble(){
    const sel = ['.logo span', '.logo', '.logo-mark', 'nav a', 'header .btn-primary', '.status-badge',
                 '.hero-label', '.hero-title', '.hero-tagline', '.hero-description', '.hero-buttons button'];
    function lerp(a,b,t){ return Math.round(a + (b-a)*t); }
    function gradColor(t){ return 'rgb(' + lerp(0,167,t) + ',' + lerp(212,139,t) + ',' + lerp(255,250,t) + ')'; } // cyan -> purple
    let raw = [];
    document.querySelectorAll(sel.join(',')).forEach(function(el){
      const r = el.getBoundingClientRect();
      if(r.width < 3 || r.height < 3 || r.top > H - 6 || r.bottom < 0) return;
      const solid = el.classList.contains('btn-primary') || el.classList.contains('logo-mark') || el.tagName === 'BUTTON';
      const grad = el.classList.contains('gradient-text');
      const baseCol = solid ? (el.classList.contains('logo-mark') ? '#dbeafe' : '#00d4ff') : getComputedStyle(el).color;
      const step = solid ? 6 : 5;
      const size = solid ? 4 : 3;
      const keep = solid ? 0.95 : 0.8;
      for(let y = r.top; y < r.bottom; y += step){
        for(let x = r.left; x < r.right; x += step){
          if(Math.random() > keep) continue;
          const col = grad ? gradColor((x - r.left) / Math.max(1, r.width)) : baseCol;
          raw.push({ x: x, y: y, col: col, size: size });
        }
      }
    });
    // cap + shuffle for an even fill
    const MAX = mobile ? 460 : 1200;
    for(let i = raw.length - 1; i > 0; i--){ const j = (Math.random()*(i+1))|0; const t = raw[i]; raw[i] = raw[j]; raw[j] = t; }
    if(raw.length > MAX) raw = raw.slice(0, MAX);

    const arr = [];
    raw.forEach(function(pt){
      const p = document.createElement('div');
      p.className = 'ipx';
      const sx = Math.random() * W, sy = Math.random() * H;
      p.style.cssText = 'width:'+pt.size+'px;height:'+pt.size+'px;left:'+sx+'px;top:'+sy+'px;background:'+pt.col+';color:'+pt.col+';opacity:0;transform:scale(0.2);';
      intro.appendChild(p);
      arr.push({ p: p, dx: pt.x - sx, dy: pt.y - sy });
    });
    void intro.offsetWidth;
    // fly in slowly and snap precisely onto the content
    arr.forEach(function(o){
      const delay = Math.random() * 320;
      o.p.style.transition = 'transform .95s cubic-bezier(.2,.75,.2,1) ' + delay + 'ms, opacity .3s ease ' + delay + 'ms';
      o.p.style.transform = 'translate(' + o.dx + 'px,' + o.dy + 'px) scale(1)';
      o.p.style.opacity = '1';
    });
    // hold the assembled, color-matched layout, then dissolve to reveal the real site beneath
    setTimeout(function(){
      arr.forEach(function(o){ o.p.style.transition = 'opacity .6s ease, transform .6s ease'; o.p.style.opacity = '0'; });
      grid.style.transition = 'opacity .6s ease'; grid.style.opacity = '0';
      intro.style.transition = 'opacity .65s ease'; intro.style.opacity = '0';
      document.body.classList.remove('intro-active');
    }, 1900);
    setTimeout(function(){ intro.remove(); }, 2700);
  }
  setTimeout(assemble, 520);
})();

/* ===== Scroll reveal ===== */
(function(){
  const items = document.querySelectorAll('.reveal');
  if(!('IntersectionObserver' in window)){
    items.forEach(function(el){ el.classList.add('reveal-in'); });
    return;
  }
  document.querySelectorAll('.grid-2, .grid-3').forEach(function(g){
    g.querySelectorAll('.card').forEach(function(card, i){
      card.style.transitionDelay = ((i % 4) * 0.07) + 's';
    });
  });
  const io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        e.target.classList.add('reveal-in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  items.forEach(function(el){ io.observe(el); });
  // Safety net: never leave content hidden if the observer can't deliver
  // (e.g. document rendered while hidden / JS hiccup).
  function showAll(){ items.forEach(function(el){ el.classList.add('reveal-in'); }); }
  if(document.hidden) showAll();
  setTimeout(function(){
    items.forEach(function(el){
      const r = el.getBoundingClientRect();
      if(r.top < window.innerHeight + 120) el.classList.add('reveal-in');
    });
  }, 2500);
})();
</script>

